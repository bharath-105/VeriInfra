# VeriInfra Environment Configuration Template
# Copy this file to .env before running services.

# MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=veriinfra/v1

# Simulation Settings
SIMULATOR_NUM_NODES=2
SIMULATOR_PUBLISH_INTERVAL_SEC=1.0
SIMULATOR_HEARTBEAT_INTERVAL_SEC=10.0

# Storage & Database
SQLITE_DB_PATH=gateway/veriinfra_edge.db
POSTGRES_URI=postgresql://veriinfra_user:veriinfra_pass@localhost:5432/veriinfra_db

# Gateway Settings
GATEWAY_ID=edge_gateway_01
EMERGENCY_OVERRIDE_ENABLED=true
